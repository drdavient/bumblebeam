[Unit]
Description=Reboot telemetry: shutdown-complete marker (ADR 0016)
# Started very early at boot so that its ExecStop runs very LATE in shutdown —
# after services have stopped, just before local filesystems unmount.
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target
# DefaultDependencies=no drops the implicit Conflicts=shutdown.target — without
# these two lines systemd never stops the unit at shutdown and ExecStop (the
# whole point) never runs.
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/home/drdavient/docker/ops/reboot-telemetry/reboot-telemetry.sh marker

[Install]
WantedBy=sysinit.target
